{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "flexkinetic\\.com" }],
      "destination": "https://getdempsey.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www\\.flexkinetic\\.com" }],
      "destination": "https://getdempsey.com/:path*",
      "permanent": true
    }
  ]
}
