{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "flexkinetic\\.com" }],
      "destination": "https://getdempsey.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www\\.flexkinetic\\.com" }],
      "destination": "https://getdempsey.com/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "flexkinetic\\.com" }],
      "destination": "https://getdempsey.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www\\.flexkinetic\\.com" }],
      "destination": "https://getdempsey.com/$1",
      "permanent": true
    }
  ]
}
